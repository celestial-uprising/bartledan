FROM fedora:latest

LABEL com.github.containers.toolbox="true" \
      com.github.debarshiray.toolbox="true" \
      org.opencontainers.image.title="bartledan" \
      org.opencontainers.image.description="Pi Agent Sandbox for Celestial-Uprising"

# Set terminal encoding and container fallbacks
ENV LANG=en_US.UTF-8 \
    PI_CODING_AGENT_DIR=/opt/pi-agent/config 

# Mark as a valid Toolbx container
RUN touch /etc/toolbox-release

# Install Toolbx prerequisites, core CLI utilities, and Node.js stack in a single optimized layer
RUN dnf -y update --nodocs && \
    dnf -y install --nodocs \
      git \
      curl \
      wget \
      btop \
      vim \
      ripgrep \
      fd-find \
      jq \
      tmux \
      nodejs \
      npm \
      shadow-utils \
      util-linux && \
    dnf clean all && \
    rm -rf /var/cache/dnf

# Create configuration directory structure
RUN mkdir -p ${PI_CODING_AGENT_DIR}

# Install Pi Agent globally and clean NPM cache
RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent && \
    npm cache clean --force

# Inject settings.json with full provider suite
RUN jq -n \
  '{ \
    "provider": "openai", \
    "packages": [ \
      "npm:pi-web-search", \
      "npm:pi-powerline-footer", \
      "npm:billion-context", \
      "npm:@skdev-ai/pi-gemini-cli-provider", \
      "npm:pi-llama-cpp-stats", \
      "npm:pi-nvidia-nim", \
      "npm:pi-extension-nvidia-nim" \
    ] \
  }' > ${PI_CODING_AGENT_DIR}/settings.json

# Inject default configuration for SoL-Pi local efficiency features
RUN echo '{"version": 1, "actionFusion": true, "observationPack": true, "evidencePreservingReducer": false, "onlineContextCompact": false}' \
  > ${PI_CODING_AGENT_DIR}/sol-pi.json

# Grant permissive read/write access for non-root host user execution under Toolbx
RUN chmod -R 777 /opt/pi-agent

# Shell configuration setup for interactive Toolbx entry
RUN echo 'alias pi="PI_CODING_AGENT_DIR=/opt/pi-agent/config pi"' >> /etc/bashrc
