FROM fedora:latest

LABEL com.github.containers.toolbox="true" \
      com.github.debarshiray.toolbox="true" \
      org.opencontainers.image.title="bartledan" \
      org.opencontainers.image.description="Optimized Pi Agent sandbox for Celestial-Uprising project"

# Install Toolbx prerequisites, core utilities, and modern Node.js ecosystem dependencies
RUN dnf -y update && dnf -y install \
    git curl wget btop vim ripgrep fd-find zoxide bat eza jq tmux nodejs npm passwd \
    && dnf clean all

# Set terminal encoding and container fallbacks
ENV LANG=en_US.UTF-8
ENV PI_CODING_AGENT_DIR=/opt/pi-agent/config

# Create configuration and theme workspace structures
RUN mkdir -p ${PI_CODING_AGENT_DIR}/themes

# Install Pi Agent AND both pieces of the Google Gemini CLI A2A server framework globally
RUN npm install -g --ignore-scripts \
    @earendil-works/pi-coding-agent \
    @google/gemini-cli \
    @google/gemini-cli-a2a-server

# Build out an atomic settings injection to provision the minimalist layout suite and Gemini provider
RUN jq -n \
  '{"theme": "lesbian-minimal", "packages": ["npm:statusline-pi", "npm:pi-slate", "npm:@skdev-ai/pi-gemini-cli-provider", "git:://github.com", "npm:billion-context"], "pi-statusline": {"palette": {"model": "#D52D00", "activity": "#FF9A55"}}}' \
  > ${PI_CODING_AGENT_DIR}/settings.json

# Inject the beautiful, minimal Lesbian custom theme palette
RUN jq -n \
  --arg name "lesbian-minimal" \
  --arg sunset_orange "#D52D00" \
  --arg light_orange "#FF9A55" \
  --arg cream_white "#FFFFFF" \
  --arg soft_pink "#D362A4" \
  --arg dusty_rose "#A30262" \
  --arg bg_slate "#121417" \
  '{name: $name, vars: {"sunset-orange": $sunset_orange, "light-orange": $light_orange, "cream-white": $cream_white, "soft-pink": $soft_pink, "dusty-rose": $dusty_rose, "bg-slate": $bg_slate}, colors: {"interface.background": "var(bg-slate)", "interface.foreground": "var(cream-white)", "messages.user.border": "var(soft-pink)", "messages.agent.border": "var(light-orange)", "markdown.header": "var(sunset-orange)", "markdown.link": "var(soft-pink)", "editor.mode.normal": "var(dusty-rose)", "editor.mode.insert": "var(light-orange)"}}' \
  > ${PI_CODING_AGENT_DIR}/themes/lesbian-minimal.json

# Inject a default configuration for SoL-Pi to enable core local efficiency features safely
RUN echo '{"version": 1, "actionFusion": true, "observationPack": true, "evidencePreservingReducer": false, "onlineContextCompact": false}' \
  > ${PI_CODING_AGENT_DIR}/sol-pi.json

# Expose target permissions natively for runtime container invocation modifications
RUN chmod -R 777 /opt/pi-agent

# Set up global profile triggers to automatically load workspace overrides when entering Toolbx
RUN echo 'export PI_CODING_AGENT_DIR=/opt/pi-agent/config' > /etc/profile.d/pi-agent.sh && \
    echo 'alias pi="PI_CODING_AGENT_DIR=/opt/pi-agent/config pi"' >> /etc/profile.d/pi-agent.sh && \
    chmod +x /etc/profile.d/pi-agent.sh

